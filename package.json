{
  "name": "vue-legal-document-manager",
  "version": "0.1.0",
  "description": "BlueLab document manager: exclude/add documents, provision selection, a provisions and markdown viewer, guardrails and provenance. ranked-provisions@1 in, provision-set@1 out, and never calls an API.",
  "type": "module",
  "main": "./dist/vue-legal-document-manager.umd.cjs",
  "module": "./dist/vue-legal-document-manager.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-legal-document-manager.js",
      "require": "./dist/vue-legal-document-manager.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "legal",
    "documents",
    "selection",
    "bluelab"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashankmc/vue-legal-document-manager.git"
  },
  "homepage": "https://github.com/shashankmc/vue-legal-document-manager#readme",
  "bugs": {
    "url": "https://github.com/shashankmc/vue-legal-document-manager/issues"
  },
  "dependencies": {
    "legal-provision-types": "git+https://github.com/shashankmc/legal-provision-types.git#1388a4c",
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0"
  }
}
